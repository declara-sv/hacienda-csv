# HaciendaCSV API (FastAPI)
VITE_API_URL=http://localhost:5184

# Clerk (https://dashboard.clerk.com -> API keys). The publishable key is
# public; VITE_ exposes it to the browser bundle, the unprefixed copy is read
# by clerkMiddleware on the server.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Server only. Never prefix with VITE_.
CLERK_SECRET_KEY=sk_test_replace_me
