ENVIRONMENT=Development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/accounting_dev

JWT_ISSUER=Accounting.Api
JWT_AUDIENCE=Accounting.Web
JWT_SIGNING_KEY=CAMBIAR_ESTA_LLAVE_EN_PRODUCCION_32+
JWT_ACCESS_TOKEN_MINUTES=20
JWT_REFRESH_TOKEN_DAYS=30

# Local | AzureBlob
STORAGE_PROVIDER=Local
STORAGE_UPLOAD_CONTAINER=uploads
STORAGE_OUTPUT_CONTAINER=outputs
STORAGE_LOCAL_ROOT_PATH=App_Data/files
STORAGE_AZURE_BLOB_CONNECTION_STRING=

# JSON list
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_VERCEL_SUBDOMAINS=true
ENABLE_SWAGGER=true

WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=3
WORKER_RUN_TIMEOUT_MINUTES=10

# Optional AI fallback for PDFs the MH parser cannot read. Empty key = disabled.
ANTHROPIC_API_KEY=
AI_EXTRACTION_MODEL=claude-opus-5-5
AI_EXTRACTION_ENABLED=true

MAX_UPLOAD_BYTES=20000000
